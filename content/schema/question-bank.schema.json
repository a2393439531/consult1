{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "number", "title", "questions"],
  "properties": {
    "id": {"type": "string"},
    "number": {"type": "integer", "minimum": 1, "maximum": 11},
    "title": {"type": "string", "minLength": 1},
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "chapter_id", "background", "subquestions", "sources"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string", "minLength": 1},
          "chapter_id": {"type": "string"},
          "background": {"type": "string"},
          "subquestions": {"type": "array", "minItems": 1},
          "sources": {"type": "array", "minItems": 1}
        }
      }
    }
  }
}
